<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.hokims.ui.MatchSimulatorController"
      prefWidth="700" prefHeight="520">

    <!-- Top control bar for match simulation settings -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <!-- Team A selection -->
        <Label text="Team A:"/>
        <ComboBox fx:id="cboTeamA" prefWidth="180"/>

        <!-- Team B selection -->
        <Label text="Team B:"/>
        <ComboBox fx:id="cboTeamB" prefWidth="180"/>

        <!-- Number of rounds selection -->
        <Label text="Rounds:"/>
        <Spinner fx:id="spRounds" prefWidth="80"/>

        <!-- Start simulation button -->
        <Button fx:id="btnStart" text="Start" onAction="#handleStart"/>
    </HBox>

    <!-- TableView to display battle log/results -->
    <TableView fx:id="tblLog" prefHeight="450"/>
</VBox>
