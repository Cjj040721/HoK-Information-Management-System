<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.example.hokims.ui.SettingsController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="800" prefHeight="500">

    <!-- Center content: Data management operations -->
    <center>
        <VBox spacing="15" alignment="CENTER">

            <!-- Section title -->
            <Label text=" Data Management Console"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <!-- Row: Data type selection and ID input for deletion -->
            <HBox spacing="10" alignment="CENTER">
                <Label text="Type:" />
                <ComboBox fx:id="dataTypeCombo" promptText="Choose Type"/>
                <Label text="ID:" />
                <TextField fx:id="dataIdField" promptText="Enter ID to delete or update"/>
                <Button text="Delete" onAction="#handleDelete"/>
            </HBox>

            <!-- Row: Buttons to add different data types -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Add Player" onAction="#handleAddPlayer"/>
                <Button text="Add Hero" onAction="#handleAddHero"/>
                <Button text="Add Equipment" onAction="#handleAddEquipment"/>
                <Button text="Add Team" onAction="#handleAddTeam"/>
            </HBox>

            <!-- Row: JSON input for updating data -->
            <HBox spacing="10" alignment="CENTER">
                <Label text="Update JSON:" />
                <TextField fx:id="editJsonField" prefWidth="400"
                           promptText="{&quot;id&quot;:&quot;P1001&quot;,&quot;name&quot;:&quot;Edited Player&quot;}"/>
                <Button text="Update" onAction="#handleUpdate"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
