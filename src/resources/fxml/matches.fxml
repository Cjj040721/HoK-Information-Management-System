<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hokims.ui.MatchesController"
      spacing="10">

    <!-- Padding around the VBox content -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Main title label -->
    <Label text="Matches List"
           style="-fx-font-size: 24px; -fx-text-fill: #FFD700; -fx-font-weight: bold;"
           alignment="CENTER"
           maxWidth="Infinity"
    />

    <!-- Instruction label for user interaction -->
    <Label text="Double-click a match to view details."
           styleClass="double-click-label"
           AnchorPane.leftAnchor="10" AnchorPane.topAnchor="50"/>

    <!-- TableView displaying match details -->
    <TableView fx:id="matchTable" prefHeight="600.0" VBox.vgrow="ALWAYS">
        <columns>
            <!-- Column for Match ID -->
            <TableColumn fx:id="colMatchId" text="Match ID" />
            <!-- Column for Match Date -->
            <TableColumn fx:id="colDate" text="Date" />
            <!-- Column for Team A Name -->
            <TableColumn fx:id="colTeamA" text="Team A" />
            <!-- Column for Team A Score -->
            <TableColumn fx:id="colScoreA" text="Score A" />
            <!-- Column for Team B Name -->
            <TableColumn fx:id="colTeamB" text="Team B" />
            <!-- Column for Team B Score -->
            <TableColumn fx:id="colScoreB" text="Score B" />
            <!-- Column for Match Winner -->
            <TableColumn fx:id="colWinner" text="Winner" />
        </columns>
    </TableView>
</VBox>
